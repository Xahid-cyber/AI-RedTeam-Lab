{
  "run": {
    "soft_probe_prompt_cap": 5
  },
  "rest": {
    "RestGenerator": {
      "name": "Northwind Retail Chatbot",
      "uri": "http://127.0.0.1:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "response",
      "request_timeout": 300
    }
  }
}